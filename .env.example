# ── PostgreSQL ──
# 로컬 기본값 (설치 후 postgres 사용자 비밀번호에 맞게 수정)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_smart_factory_erp

# 또는 개별 변수
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=ai_smart_factory_erp

# ── Google Gemini API ──
# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=your_gemini_api_key_here

# ── Cloudinary (채팅 피드 이미지 업로드, 선택) ──
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ── 서버 ──
NODE_ENV=development
PORT=5000
